# Copie para .env e preencha os valores reais. NUNCA commit o .env.

# --- Aplicação ---
APP_NAME=
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Base de dados ---
DATABASE_URL=

# --- Autenticação / segredos ---
JWT_SECRET=
SESSION_SECRET=

# --- Serviços externos ---
# API_KEY_SERVICO_X=

# --- Deploy / servidor (usado pelos workflows em .github/workflows) ---
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PATH=/var/www/app
